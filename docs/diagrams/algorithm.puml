@startuml
start
:Загрузка данных (CSV / Excel);
:Определение типа данных;
if (Тип данных = "инциденты"?) then (да)
  :Сохранение в таблицу incidents;
else (нет)
  if (Тип данных = "отказы оборудования"?) then (да)
    :Сохранение в таблицу equipment_failures;
  else (иначе)
    :Сохранение в таблицу safety_violations;
  endif
endif
:Просмотр данных и фильтрация;
:Выбор метода анализа;
if (Метод = "описательная статистика"?) then (да)
  :Расчёт статистических показателей;
else (нет)
  if (Метод = "тренд-анализ"?) then (да)
    :Линейная регрессия и прогноз;
  else (нет)
    if (Метод = "анализ Пуассона"?) then (да)
      :Расчёт λ и распределения;
    else (иначе — FMEA)
      :Расчёт S, O, D и RPN;
    endif
  endif
endif
:Отображение результатов;
if (Экспорт = "PDF"?) then (да)
  :Формирование отчёта по ГОСТ;
else (Excel)
  :Экспорт в Excel;
endif
stop
@enduml
