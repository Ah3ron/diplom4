@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam dpi 150
left to right direction

package "statistics" {
class DescriptiveStats {
+count : int
+mean : float
+std : float
+min : float
+q1 : float
+median : float
+q3 : float
+max : float
}
class PoissonResult {
+lambda_est : float
+probabilities : List
+forecast : List
+ci : Tuple<float,float>
}
class TrendResult {
+trend_direction : str
+slope : float
+r2 : float
+moving_avg : List
+forecast : List
}
class StatisticsResponse {
+descriptive : DescriptiveStats
+poisson? : PoissonResult
+trend? : TrendResult
}
}

package "core" {
class IncidentBase {
+date : date
+department : str
+type : str
+severity : SeverityLevel
+days_lost : int
}
class IncidentStatistics {
+total_incidents : int
+days_lost : int
+by_department : dict
}
class EquipmentFailureBase {
+date : date
+equipment : str
+op_hours : float
+downtime : float
+cost : float
}
class EquipmentStatistics {
+total_failures : int
+downtime : float
+mtbf : float
}
class SafetyViolationBase {
+date : date
+department : str
+type : str
+audit_finding : bool
}
class SafetyStatistics {
+total_violations : int
+by_department : dict
}
class ExportRequest {
+format : ExportFormat
+report_type : str
+filters : dict
}
}

package "risk" {
class RiskMatrixCell {
+likelihood : int
+severity : SeverityLevel
+risk_level : int
+color : RiskColor
+rec : str
}
class RiskMatrixResult {
+matrix : List<List>
+assessment : dict
}
class FMEAResult {
+id : UUID
+failure_mode : str
+severity : int
+occurrence : int
+detection : int
+rpn : int
}
class FMEAAnalysis {
+name : str
+items : List
+avg_rpn : float
+recommendations : List
}
}

package "models" {
class RiskAssessment {
+id : int
+method : str
+name : str
+input : JSON
+result : JSON
+created_at : datetime
}
class EquipmentFailure {
+id : int
+date : date
+equipment : str
+downtime : float
+cost : float
}
class SafetyViolation {
+id : int
+date : date
+department : str
+type : str
}
class Incident {
+id : int
+date : date
+department : str
+type : str
+severity : SeverityLevel
}
class MedicalExam {
+id : int
+date : date
+profession : str
+findings : str
}
}

StatisticsResponse --> DescriptiveStats : "содержит"
StatisticsResponse --> PoissonResult : "содержит 0..1"
StatisticsResponse --> TrendResult : "содержит 0..1"

IncidentBase --> IncidentStatistics : "генерирует"
EquipmentFailureBase --> EquipmentStatistics : "генерирует"
SafetyViolationBase --> SafetyStatistics : "генерирует"

RiskAssessment --> RiskMatrixResult : "может генерировать 0..1"
FMEAAnalysis --> FMEAResult : "запускает / содержит"

Incident ..> IncidentBase : "соответствует"
EquipmentFailure ..> EquipmentFailureBase : "соответствует"
SafetyViolation ..> SafetyViolationBase : "соответствует"

RiskMatrixCell "1" --> "1" RiskMatrixCell : "оценивает"
FMEAResult "1" --> "1" FMEAResult : "отображается в"
@enduml
